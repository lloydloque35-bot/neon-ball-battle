# ─────────────────────────────────────────────────────────────
# NEON BALL BATTLE: ULTIMATE GODS — server configuration
# Copy to .env (never commit .env) and fill in. Secrets stay on the server only.
# ─────────────────────────────────────────────────────────────

# development | production
NODE_ENV=development
PORT=8080
# HOST=0.0.0.0
# Public URL players use (https:// required in production). Used for CSRF origin checks and payment redirects.
APP_ORIGIN=http://localhost:8080

# Database & backups (SQLite file; the folder is created automatically)
DB_FILE=./data/game.db
BACKUP_DIR=./data/backups

# Cookies: true in production (requires HTTPS). TRUST_PROXY=true only behind a reverse proxy you control.
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_DAYS=30

# Owner dashboard: 2FA must have been verified within this many minutes (sliding)
ADMIN_MFA_MAX_AGE_MIN=30

# Battle verification worker threads (1-4) and maximum battle length
VERIFY_WORKERS=1
MAX_BATTLE_MINUTES=30

# New accounts per IP per hour
LIMIT_REGISTER_PER_HOUR=5

# ── Payments (Stripe) ─────────────────────────────────────────
# disabled → no checkout | test → Stripe sandbox (test keys, test cards) | live → real money
PAYMENTS_MODE=disabled
# sk_test_... (test) or sk_live_... (live). NEVER put this key in front-end code.
STRIPE_SECRET_KEY=
# whsec_... from the Stripe webhook endpoint pointing at  <APP_ORIGIN>/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# price_... of a recurring price: 200.00 USD, interval = year
STRIPE_PRICE_ID=
# Renewal disclosure shown to players (Stripe subscriptions renew yearly until turned off)
PREMIUM_AUTO_RENEW=true
# Live mode stays locked until you set this AFTER finishing Stripe merchant verification, tax and legal setup.
PAYMENTS_LIVE_CONFIRMED=false

# ── Email (optional, for password-reset links) ────────────────
# Resend.com API key and a verified sender. Without it, players recover with recovery codes.
RESEND_API_KEY=
MAIL_FROM=

LOG_LEVEL=info
